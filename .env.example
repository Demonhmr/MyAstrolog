# Токен бота от @BotFather (обязательно)
BOT_TOKEN=your_telegram_bot_token_here

# Нейросеть для живого текста прогноза (OpenAI-совместимый API, по умолчанию OpenRouter).
# Без ключа бот работает: текст «как хочешь / как будет» берётся из справочника.
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5.5
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Тарифы (core/plans.py): one 150 ₽ / p3 390 / p6 590 / p13 990 / plus 1590; в боте — звёзды (100/260/395/660/1060).
# Переопределить цену: PRICE_<КОД>_RUB=…, PRICE_<КОД>_STARS=…  (например PRICE_P3_STARS=250)

# Бот: false — всё бесплатно; true — прошлый месяц бесплатно, остальные — по оплате звёздами (/premium)
PAYWALL_ENABLED=false

# Сайт и Android: off — всё бесплатно; test — тарифы только для адресов из PAYWALL_TEST_EMAILS
# и @test.invalid (проверка оплаты до запуска); on — для всех
WEB_PAYWALL=off
PAYWALL_TEST_EMAILS=

# Robokassa (магазин zvezditsa.ru): Result URL https://zvezditsa.ru/api/robokassa/result (POST),
# Success URL https://zvezditsa.ru/app/pay-ok, Fail URL https://zvezditsa.ru/app/pay-fail, хеш SHA256.
# Пока логина и паролей нет — кнопки оплаты показывают «Оплата скоро заработает».
RK_LOGIN=
RK_TEST=1
RK_TEST_PASS1=
RK_TEST_PASS2=
RK_PASS1=
RK_PASS2=
RK_HASH=sha256

# Письма с кодом входа: через exim на этом VPS (DKIM по /etc/exim4/dkim/zvezditsa.ru.private)
MAIL_FROM=no-reply@zvezditsa.ru
# MAIL_HOST=127.0.0.1
# Адреса @test.invalid писем не получают, их код — TEST_LOGIN_CODE. Задавать только на время автотестов!
# TEST_LOGIN_CODE=

# Контакт поддержки по оплате (/paysupport) и ссылки на документы
SUPPORT_CONTACT=почта@пример.ru
# PRIVACY_URL=https://zvezditsa.ru/bot/privacy
# CONSENT_URL=https://zvezditsa.ru/bot/consent
# TERMS_URL=https://zvezditsa.ru/bot/oferta

# Путь к базе (в Docker база лежит в томе zvezditsa_data, менять не нужно)
# DB_PATH=/app/storage/zvezditsa.db
