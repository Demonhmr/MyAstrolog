# Токен бота от @BotFather (обязательно)
BOT_TOKEN=your_telegram_bot_token_here

# Нейросеть для живого текста прогноза (OpenAI-совместимый API, по умолчанию OpenRouter).
# Без ключа бот работает: текст «как хочешь / как будет» берётся из справочника.
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5.5
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Платный доступ: false — весь прогноз бесплатно;
# true — без подписки только короткая версия, в /premium появляются кнопки оплаты звёздами
PAYWALL_ENABLED=false
PRICE_MONTH_STARS=200
PRICE_YEAR_STARS=1700

# Контакт поддержки по оплате (/paysupport) и ссылки на документы
SUPPORT_CONTACT=почта@пример.ru
# PRIVACY_URL=https://zvezditsa.ru/privacy.html
# CONSENT_URL=https://zvezditsa.ru/consent.html
# TERMS_URL=https://zvezditsa.ru/oferta.html

# Путь к базе (в Docker база лежит в томе zvezditsa_data, менять не нужно)
# DB_PATH=/app/storage/zvezditsa.db
